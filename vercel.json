{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/(api|auth|subscription|license|admin|showcase|resources|feedback|health)(.*)",
      "destination": "/api"
    }
  ]
}
