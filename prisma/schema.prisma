generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  email            String             @unique
  username         String?            @unique
  password         String
  name             String
  role             Role               @default(USER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subscription     Subscription?
  devices          Device[]
  verificationCodes VerificationCode[]
  licenseKeys      LicenseKey[]
}

model Subscription {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @unique @db.ObjectId
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SubscriptionStatus @default(INACTIVE)
  plan          SubscriptionPlan   @default(STARTER)
  isPremium     Boolean            @default(false)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Device {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String  @unique
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  code      String
  type      CodeType @default(PASSWORD_RESET)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, code])
}

enum CodeType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
  LIFETIME
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  STUDIO
  LIFETIME
}

enum KeyType {
  ORIGINAL
  PREMIUM
}

model LicenseKey {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  key          String    @unique
  keyType      KeyType   @default(ORIGINAL)
  durationDays Int       @default(90)
  status       KeyStatus @default(UNUSED)
  userId       String?   @db.ObjectId
  user         User?     @relation(fields: [userId], references: [id])
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())
}


enum KeyStatus {
  UNUSED
  ACTIVE
  EXPIRED
}

model ShowcaseImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  publicId  String?
  title     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type ShowcasePhoto {
  id        String?
  url       String
  publicId  String?
  title     String?
  order     Int      @default(0)
}

model ShowcaseAlbum {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  images      ShowcasePhoto[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Resource {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  category     String
  title        String
  description  String
  hashtags     String[]  @default([])
  isVip        Boolean   @default(false)
  isHot        Boolean   @default(false)
  fileFormat   String    @default(".ZIP")
  rating       Float     @default(5.0)
  size         String    @default("0 MB")
  downloadType String    @default("DIRECT") // "DIRECT" | "DRIVE"
  downloadUrl  String?
  fileData     String?   // Base64 file data for direct DB storage (<5MB)
  fileName     String?
  mimeType     String?
  fileSize     Int?
  author       String    @default("MVD Academy")
  downloads    Int       @default(0)
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

